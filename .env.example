# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

APP_ENV=local
LOG_LEVEL=INFO
LOG_JSON=false
API_HOST=127.0.0.1
API_PORT=8000
# Local http only. Must be true anywhere served over HTTPS.
COOKIE_SECURE=false
PUBLIC_APP_URL=http://127.0.0.1:3000

# Long random string (32+ characters outside local/test).
APP_SECRET_KEY=change-me

# Local Docker services (compose.yaml)
POSTGRES_USER=voice
POSTGRES_PASSWORD=change-me
POSTGRES_DB=voice_platform
POSTGRES_PORT=5432
REDIS_PASSWORD=change-me
REDIS_PORT=6379

# Runtime connection as the restricted voice_app role (row-level security applies).
DATABASE_URL=postgresql://voice_app:change-me-app@127.0.0.1:5432/voice_platform
APP_DB_PASSWORD=change-me-app
# Owner connection, used only by migrations and db-setup. Must match POSTGRES_* above.
MIGRATION_DATABASE_URL=postgresql://voice:change-me@127.0.0.1:5432/voice_platform
REDIS_URL=redis://:change-me@127.0.0.1:6379/0
