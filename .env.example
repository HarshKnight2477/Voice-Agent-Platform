# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

APP_ENV=local
LOG_LEVEL=INFO
LOG_JSON=false
API_HOST=127.0.0.1
API_PORT=8000
# Local http only. Must be true anywhere served over HTTPS.
COOKIE_SECURE=false
PUBLIC_APP_URL=http://127.0.0.1:3000

# Long random string (32+ characters outside local/test).
APP_SECRET_KEY=change-me

# Local Docker services (compose.yaml)
POSTGRES_USER=voice
POSTGRES_PASSWORD=change-me
POSTGRES_DB=voice_platform
POSTGRES_PORT=5432
REDIS_PASSWORD=change-me
REDIS_PORT=6379

# Runtime connection as the restricted voice_app role (row-level security applies).
DATABASE_URL=postgresql://voice_app:change-me-app@127.0.0.1:5432/voice_platform
APP_DB_PASSWORD=change-me-app
# Owner connection, used only by migrations and db-setup. Must match POSTGRES_* above.
MIGRATION_DATABASE_URL=postgresql://voice:change-me@127.0.0.1:5432/voice_platform
REDIS_URL=redis://:change-me@127.0.0.1:6379/0

# LLM provider. Agents pick a tier (fast / balanced / deep); map each tier to a model id
# from your provider's current model list. Keep real ids and keys only in .env.
# anthropic (hosted) or ollama (free, local: https://ollama.com, e.g. `ollama pull qwen3:8b`)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
ANTHROPIC_API_KEY=
LLM_MODEL_FAST=set-model-id
LLM_MODEL_BALANCED=set-model-id
LLM_MODEL_DEEP=set-model-id

# LiveKit. Local Docker server (compose.yaml) uses the public development keys below.
# For LiveKit Cloud, use your project's URL (wss://...) and an API key/secret from its settings.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Speech: free local servers (docker compose --profile speech up -d)
SPEECH_PROVIDER=local
LOCAL_STT_URL=http://127.0.0.1:8001/v1
LOCAL_STT_MODEL=Systran/faster-whisper-base.en
LOCAL_TTS_URL=http://127.0.0.1:8880/v1
LOCAL_TTS_VOICE=af_heart
